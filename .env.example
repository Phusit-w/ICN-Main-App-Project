# Copy this file to `.env` next to docker-compose.yml and set real values
# before running `docker compose up`. This .env is only for docker-compose —
# the app container gets DATABASE_URL from docker-compose.yml, not from here.
POSTGRES_PASSWORD=change-me

# Signs per-user login session cookies (proxy.ts, lib/auth.ts) — every
# person gets their own username/password (see docs/DEPLOY.md's "การเพิ่ม
# ผู้ใช้" section for how to create accounts), this just needs to be a long
# random value unique to this deployment. Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# How many days of automatic database backups to keep in ./backups (see
# backup.sh) before older ones are deleted. Optional — defaults to 30 if
# not set.
# BACKUP_RETENTION_DAYS=30

# SOC document analysis is provider-neutral and fails closed. "disabled"
# performs only local deterministic checks and never sends files outside.
SOC_AI_PROVIDER=disabled

# Address SOC Runners call back, written into the soc-runner.json config a
# user downloads from /soc (docs/SOC-RUNNER.md). Set it to the URL users
# open the app on; unset, the download request's own origin is used.
# SOC_RUNNER_SERVER_URL=https://192.168.51.43

# Shared secret the Project Card extraction script sends as
# `Authorization: Bearer <key>` to /api/project-card/ingest — see
# docs/adr/0005-project-card-push-based-ingest.md. Same generation command
# as SESSION_SECRET above.
PROJECT_CARD_INGEST_KEY=change-me
