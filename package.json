{
  "name": "expense-billing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --env-file-if-exists=.env.test --import ./test/register.mjs --test-global-setup=./test/global-setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-test-module-mocks --test-concurrency=1 --test \"{test,lib,actions,app}/**/*.test.ts\"",
    "soc:worker": "python soc-worker/worker.py",
    "soc:test": "python -m unittest soc-worker/test_worker.py -v",
    "soc:runner": "python soc-runner/runner.py",
    "soc:runner:test": "python -m unittest discover -s soc-runner -p \"test_*.py\" -v",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mupdf": "1.28.1",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
