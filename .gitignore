# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-soc-verify/
/.next-admin-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
_devserver.log

# python
__pycache__/
*.pyc

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma's generated client — prisma/schema.prisma's `output` points here,
# not app/generated/prisma (that path never matched anything real, so
# lib/generated/prisma was being committed wholesale — a regeneratable
# build artifact, same category as node_modules, not meant for version
# control; run `npx prisma generate` to recreate it after cloning).
/lib/generated/prisma

# Skill/reference-doc caches for various AI coding tools — local tooling
# metadata, not application code, and not something this project's own
# contributors need in version control.
/.claude/
/.agents/
/.windsurf/

# native-Windows deploy (run-loop.ps1 / install-service.ps1 output)
/logs

# database backups (docker-compose's `backup` service / backup-postgres.ps1)
# — real financial/employee data, never commit these
/backups

# Private uploaded SOC/Datasheet files and generated reports. Production
# uses a named Docker volume or SOC_STORAGE_ROOT outside the repository.
/data/soc
/soc-worker/test-output

# deploy archive produced by `git archive` for server transfer — a build
# artifact, rebuilt each deploy; never version-control it
/expense-billing-app-deploy.zip

# scratch space for one-off scripts/fixtures used while poking at SOC UAT
# data by hand — not part of the app, not meant for version control
/tmp

# SOC Runner config holds a runner token
soc-runner.json

# SOC Runner installer build (soc-runner/installer/build.py): cached Python
# package, staging folder and the built SOCRunnerSetup.exe
/soc-runner/dist/
/soc-runner/installer/.cache/
/soc-runner/installer/.build/

# SOC Runner run from source: its lock and log next to soc-runner.json
/soc-runner/runner.lock
/soc-runner/runner.log*
