// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// No longer read or written by the app (see actions/profile.ts) — the
// single shared row here used to prefill new bills, but with no login,
// every visitor's browser wrote to it on every field blur, so two people
// at the office at once could silently overwrite each other's info.
// Replaced by a per-browser cookie that points at a SavedEmployee entry
// instead (nothing shared to collide over). Left in the schema rather than
// migrated away, since dropping it would need a migration against
// whatever's already live and isn't worth the risk for a now-unused table.
model EmployeeProfile {
  id         String   @id @default(cuid())
  name       String   @default("")
  position   String   @default("")
  department String   @default("")
  office     String   @default("")
  employeeNo String   @default("")
  projectCC  String   @default("")
  updatedAt  DateTime @updatedAt
}

// Multiple named "reuse" entries, distinct from EmployeeProfile's single
// org-wide default above — this is for the common case of several different
// people sharing this same (login-less) app: each can save their own
// details once under their name via "บันทึกไว้ใช้ซ้ำ" (EntryEmployeeFields),
// then pick themselves back out of the saved-name list next time instead of
// retyping or overwriting the one shared default. `name` is the lookup
// key — saving again under the same name updates that entry in place
// rather than creating a duplicate.
model SavedEmployee {
  id         String   @id @default(cuid())
  name       String   @unique
  position   String   @default("")
  department String   @default("")
  office     String   @default("")
  employeeNo String   @default("")
  projectCC  String   @default("")
  updatedAt  DateTime @updatedAt
}

// Reusable expense-item-row templates — same "save under a key, pick it back
// out next time" idea as SavedEmployee above, but for a single row of an
// expense claim (e.g. a recurring "ค่าน้ำมันประจำเดือน" line) instead of
// employee info. `desc` (the รายการ / Description of Expenses text) is the
// lookup key, exactly like SavedEmployee.name — saving again under the same
// desc updates that entry in place. `type` scopes entries to FA017 or
// FA018, since the two forms' item shapes differ (see lib/types.ts's
// FA017Item/FA018Item). `data` holds every other field except `date` (a
// saved row is a reusable template, not tied to a specific transaction
// date) and `desc` itself (already its own column).
model SavedItem {
  id        String   @id @default(cuid())
  type      String // "FA017" | "FA018"
  desc      String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([type, desc])
  @@index([type])
}

model ExpenseRecord {
  id                 String    @id @default(cuid())
  type               String // "FA017" | "FA018"
  day                Int       @default(1) // day-of-month for the F-FA-017 "DATE :" field (unused by FA018)
  monthName          String
  monthYear          Int
  employeeName       String    @default("")
  employeePosition   String    @default("")
  employeeDepartment String    @default("")
  employeeOffice     String    @default("")
  employeeNo         String    @default("")
  employeeProjectCC  String    @default("")
  remark             String    @default("")
  // Who was logged in (User.displayName, see below) when this record was
  // created/last saved — a snapshot, not a foreign key, same denormalized-
  // string approach as SavedEmployee/EmployeeProfile above, so the audit
  // trail still reads correctly even if that User row is later renamed or
  // deleted. "" for records saved before per-user login existed.
  createdByName      String    @default("")
  updatedByName      String    @default("")
  ownerId            String?
  owner              User?     @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  deletedAt          DateTime?
  deletedById        String?
  purgeAfter         DateTime?
  restoredAt         DateTime?
  purgedAt           DateTime?
  items              Json // line items; shape differs by type (see lib/types.ts)
  total              Decimal   @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([updatedAt])
  @@index([ownerId, deletedAt, updatedAt])
  @@index([purgeAfter])
}

// A per-person login account (proxy.ts + actions/auth.ts) — replaces the
// single shared HTTP Basic Auth pair (AUTH_USERNAME/AUTH_PASSWORD) that used
// to gate the whole site. No roles/permission levels: every account can do
// everything, exactly like the old shared password could — this only splits
// "who can get in" into one row per person, mainly so ExpenseRecord's
// createdByName/updatedByName above can be trusted (an approval workflow in
// the app itself was explicitly out of scope when this was added; approval
// is still a paper signature after printing).
model User {
  id                         String            @id @default(cuid())
  username                   String            @unique
  // PBKDF2-SHA256, see lib/auth.ts's hashPassword — never plaintext.
  passwordHash               String
  displayName                String
  role                       String            @default("USER") // "USER" | "ADMIN"
  isActive                   Boolean           @default(true)
  mustChangePassword         Boolean           @default(false)
  sessionVersion             Int               @default(1)
  passwordChangedAt          DateTime?
  disabledAt                 DateTime?
  // Which apps a USER may open — values in lib/access.ts (APP_ACCESS). ADMIN
  // ignores this and may open everything. The default grants everything, so
  // accounts that existed before per-app access keep what they had.
  appAccess                  String[]          @default(["expense", "soc", "project-card-edit"])
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  socJobs                    SocJob[]
  socAuditEvents             SocAuditEvent[]
  socMajorItemsRequested     SocMajorItem[]    @relation("SocMajorItemRequestedBy")
  socMajorItemsRan           SocMajorItem[]    @relation("SocMajorItemRanBy")
  socCheckRunsImported       SocCheckRun[]
  socSkillPackagesUploaded   SocSkillPackage[]
  socRunnerLinks             SocRunnerLink[]   @relation("SocRunnerLinkUser")
  socRunnerLinksRevoked      SocRunnerLink[]   @relation("SocRunnerLinkRevokedBy")
  socCheckRequests           SocCheckRequest[]
  expenseRecords             ExpenseRecord[]   @relation("ExpenseOwner")
  auditEvents                AuditLog[]        @relation("AuditActor")
  targetedAuditEvents        AuditLog[]        @relation("AuditTarget")
  verifiedProjectCardBudgets ProjectCard[]     @relation("ProjectCardBudgetVerifier")
}

// A durable SOC audit job. PostgreSQL doubles as the low-volume work queue:
// the worker atomically claims QUEUED rows and advances the status/progress.
model SocJob {
  id            String            @id @default(cuid())
  title         String
  // "CHECK" = checked by soc-worker on the server (legacy). "IMPORTED" = an
  // Imported SOC Check (ADR 0008): results come from Local Check Runs, it
  // starts in NEEDS_REVIEW and soc-worker never claims it.
  kind          String            @default("CHECK")
  ownerId       String
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status        String            @default("DRAFT")
  stage         String            @default("รอเริ่มงาน")
  progress      Int               @default(0)
  errorMessage  String?
  expiresAt     DateTime
  confirmedAt   DateTime?
  completedAt   DateTime?
  deletedAt     DateTime?
  deletedById   String?
  purgeAfter    DateTime?
  restoredAt    DateTime?
  purgedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  documents     SocDocument[]
  results       SocCheckResult[]
  auditEvents   SocAuditEvent[]
  majorItems    SocMajorItem[]
  checkRuns     SocCheckRun[]
  checkRequests SocCheckRequest[]

  @@index([ownerId, updatedAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([deletedAt, purgeAfter])
}

model SocDocument {
  id           String        @id @default(cuid())
  jobId        String
  job          SocJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // "SOC" | "EVIDENCE" | "OUTPUT" | "PREVIEW" | "RUN_OUTPUT" (the SOC_Check
  // document of one Local Check Run)
  type         String
  originalName String
  storageKey   String        @unique
  mimeType     String
  sizeBytes    Int
  checksum     String
  pageCount    Int?
  createdAt    DateTime      @default(now())
  checkRuns    SocCheckRun[]

  @@index([jobId, type])
}

// One major item (ข้อใหญ่) of an Imported SOC Check, created with the job
// from the SOC's top-level item numbers (lib/soc-major-items.ts). One Local
// Check Run covers one major item.
model SocMajorItem {
  id               String            @id @default(cuid())
  jobId            String
  job              SocJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key              String // item number in Arabic digits, e.g. "1"
  label            String // as written in the SOC, e.g. "๑"
  title            String?
  position         Int
  // not_checked | requested | running | paused_quota | needs_login |
  // needs_documents | checked | failed. While a Check Request is open it
  // mirrors that request's state.
  state            String            @default("not_checked")
  // Of the latest Local Check Run.
  skillVersion     String?
  model            String?
  runSource        String? // "manual" | "runner"
  lastRunAt        DateTime?
  requestedById    String?
  requestedBy      User?             @relation("SocMajorItemRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  ranById          String?
  ranBy            User?             @relation("SocMajorItemRanBy", fields: [ranById], references: [id], onDelete: SetNull)
  missingDocuments Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  checkRuns        SocCheckRun[]
  results          SocCheckResult[]
  checkRequests    SocCheckRequest[]

  @@unique([jobId, key])
  @@index([jobId, position])
}

// One imported Local Check Run (ADR 0008): the results of one major item,
// written only by lib/soc-import.ts.
model SocCheckRun {
  id           String           @id @default(cuid())
  jobId        String
  job          SocJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  majorItemId  String
  majorItem    SocMajorItem     @relation(fields: [majorItemId], references: [id], onDelete: Cascade)
  source       String // "manual" | "runner"
  skillVersion String
  model        String
  documentId   String // the run's SOC_Check document (SocDocument type RUN_OUTPUT)
  document     SocDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rowCount     Int
  importedById String?
  importedBy   User?            @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  results      SocCheckResult[]

  @@index([majorItemId, createdAt])
}

model SocCheckResult {
  id                     String        @id @default(cuid())
  jobId                  String
  job                    SocJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber              Int
  item                   String
  rowType                String
  socText                String
  referenceText          String
  referencePages         Json
  evidenceDocumentId     String?
  aiReferenceCheck       String
  aiHeadingTitleCheck    String
  aiProductIdentity      String
  aiContentRelevance     String
  aiDetail               String
  aiConfidence           String
  // Automated results are separated by engine. The legacy ai* columns stay
  // populated for compatibility with existing review/export code.
  keywordMatch           String?
  ruleVerdict            String?
  aiVerdict              String?
  semanticEvidence       Json?
  verdictReason          String?
  semanticEngineVersion  String?
  benchmarkVersion       String?
  // Imported rows (ADR 0008). The skill's reference_check, heading_title_check,
  // product_identity, content_relevance, detail and confidence go to the ai*
  // columns above; the other full-mode axes are stored here, and `rawResult`
  // keeps the row exactly as results.json gave it.
  majorItemId            String?
  majorItem              SocMajorItem? @relation(fields: [majorItemId], references: [id], onDelete: Cascade)
  runId                  String?
  run                    SocCheckRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  referenceDetail        String?
  itemLabelCheck         String?
  highlightCheck         String?
  highlightEvidence      String?
  evidenceSupport        String?
  evidenceDetail         String?
  torDecision            String?
  torDecisionBasis       String?
  verifiedValue          String?
  torThreshold           String?
  torClaimResults        Json?
  declaredStatus         String?
  declaredStatusCheck    String?
  keyIssue               String?
  rawResult              Json?
  // Imported rows: the bidder's text, read from the job's SOC at import
  // (socText holds the TOR text). The Final Decision (compliant / better /
  // non_compliant) and the reviewer's note are set on the review page, apart
  // from the System Recommendation (torDecision); setting them also sets
  // reviewedAt/reviewedById.
  proposalText           String?
  finalDecision          String?
  finalNote              String?
  finalReferenceCheck    String
  finalHeadingTitleCheck String
  finalProductIdentity   String
  finalContentRelevance  String
  finalDetail            String
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([jobId, rowNumber])
  @@index([jobId, finalReferenceCheck])
  @@index([majorItemId])
}

// A version of the SOC skill (tor-word-compliance-check) uploaded by an
// admin (ADR 0008, lib/soc-skill-package.ts). The stored file is the package
// as served to SOC Runners: the upload plus the headless step-0 instruction.
model SocSkillPackage {
  id             String            @id @default(cuid())
  version        String            @unique
  originalName   String
  storageKey     String            @unique // under SOC_STORAGE_ROOT/skill-packages/
  sizeBytes      Int
  checksum       String // sha256 of the served package
  sourceChecksum String // sha256 of the file the admin uploaded
  rootDir        String // folder holding SKILL.md inside the zip, "" or "<name>/"
  uploadedById   String?
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  current        SocCurrentSkill?
  checkRequests  SocCheckRequest[]

  @@index([createdAt])
}

// Which SocSkillPackage SOC Runners use: a single row (key "current"), so
// exactly one version is current once any package has been uploaded.
model SocCurrentSkill {
  key       String          @id @default("current")
  packageId String          @unique
  package   SocSkillPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  updatedAt DateTime        @updatedAt
}

// One SOC Runner link (ADR 0008, ticket 12): the token in a runner config a
// user downloaded from /soc, bound to that user. Only the token's sha256 is
// kept. A user has at most one active link (revokedAt null): downloading
// again revokes the previous one ("replaced"); an admin may revoke ("admin").
model SocRunnerLink {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("SocRunnerLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String            @unique
  createdAt     DateTime          @default(now())
  // From the latest heartbeat; null until the runner first reports.
  lastSeenAt    DateTime?
  runnerVersion String?
  claudeLogin   String? // "logged_in" | "logged_out" | "unknown"
  revokedAt     DateTime?
  revokeReason  String? // "replaced" | "admin"
  revokedById   String?
  revokedBy     User?             @relation("SocRunnerLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  checkRequests SocCheckRequest[]

  @@index([userId, revokedAt])
  @@index([createdAt])
}

// A Check Request (ADR 0008, ticket 13): a user's click to check one major
// item. Only the requester's own SOC Runner may claim it. Open states:
// requested | running | paused_quota | needs_login. Closed: needs_documents |
// failed | done | cancelled. See lib/soc-check-requests.ts.
model SocCheckRequest {
  id                  String           @id @default(cuid())
  jobId               String
  job                 SocJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  majorItemId         String
  majorItem           SocMajorItem     @relation(fields: [majorItemId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User             @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  state               String           @default("requested")
  // The major item's state before the request, restored on cancel.
  priorState          String
  // Row numbers with a Final Decision the requester agreed to replace (re-check).
  replaceConfirmed    Int[]            @default([])
  // Missing documents the requester chose to check without (ticket 15).
  acknowledgedMissing String[]         @default([])
  claimedByLinkId     String?
  claimedByLink       SocRunnerLink?   @relation(fields: [claimedByLinkId], references: [id], onDelete: SetNull)
  claimedAt           DateTime?
  // Last sign of life from the claiming runner: claim, report or heartbeat.
  lastSeenAt          DateTime?
  // The Skill Package served for this request, pinned at claim.
  skillPackageId      String?
  skillPackage        SocSkillPackage? @relation(fields: [skillPackageId], references: [id], onDelete: SetNull)
  progressNote        String?
  resumeAt            DateTime?
  missingDocuments    String[]         @default([])
  failureReason       String?
  runId               String?
  finishedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([requestedById, state, createdAt])
  @@index([majorItemId, createdAt])
  @@index([state, lastSeenAt])
}

model SocAuditEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       SocJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

// Append-only activity history shared by authentication, expenses, SOC and
// admin operations. Application code inserts rows but exposes no update/delete.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  summary      String
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model WorkerHeartbeat {
  name         String   @id
  status       String
  currentJobId String?
  lastError    String?
  lastSeenAt   DateTime
  updatedAt    DateTime @updatedAt
}

// See app/(app)/project-card/CONTEXT.md for the domain glossary. One row per
// signed-contract project under the `PS` share's `_BID` area, pushed by an
// external extraction script via an ingest API — this app's server has no
// network path to the share itself (ADR 0005). `projectCode` is the natural
// key the ingest upsert keys off; a re-index re-pushes every still-present
// project, so a card's `updatedAt` going stale is how a future stale-project
// check would notice a project disappeared from the share (no explicit
// deletion handling in v1). `budgetAmount` is an AI extraction and stays
// `budgetVerified: false` until a person confirms it (never shown as
// authoritative before that — see CONTEXT.md's Budget entry).
model ProjectCard {
  id                           String    @id @default(cuid())
  // The client-prefixed sequence number (e.g. `NT004`, `PEA012`) that
  // identifies a project across `_BID`'s Contract/Work Certificate
  // collections — see CONTEXT.md's Project Code entry. Replaces the old
  // full-archive crawl's folderPath as the card's identity, since a `_BID`
  // project routinely has two paths (contract + certificate), not one.
  projectCode                  String    @unique
  client                       String
  projectName                  String
  // Bilingual so a query in either language can match (ADR: Project Card
  // plain full-text search — see docs/adr/0004).
  descriptionTh                String
  descriptionEn                String
  // What the Description was written from: tor | proposal | contract | name
  // (pushed), or manual once a person edits it in the popup — after which a
  // push never overwrites it (CONTEXT.md's Description Source entry). Null
  // while the card has no Description. Values: DESCRIPTION_SOURCES in
  // lib/project-card-taxonomy.ts.
  descriptionSource            String?
  // UNC path to the project's Contract / Work Certificate under `_BID`
  // (CONTEXT.md's Folder Path entry; the third is projectFolderPath). Either
  // may be null when the project has no such document.
  contractPath                 String?
  certificatePath              String?
  // UNC path to the project's own folder in the wider archive (`_Project …`
  // on `PS`) — CONTEXT.md's Project Folder entry. Null when the project has
  // none or nobody is sure which folder it is; never a guess.
  projectFolderPath            String?
  // THB. Decimal(15,2) rather than ExpenseRecord's (12,2): some USO/telecom
  // projects run into the billions.
  budgetAmount                 Decimal?  @db.Decimal(15, 2)
  // Which document the Budget figure came from — "certificate" when a Work
  // Certificate exists (the authoritative source), "contract" when it was
  // read from the Contract instead (CONTEXT.md's Budget entry: the card
  // must label this so the two are never presented as the same kind of
  // number). Null when there's no Budget figure at all.
  budgetSource                 String?
  // As the source document states it — "included" | "excluded" |
  // "unspecified" — never normalized across projects (CONTEXT.md's VAT
  // Status entry).
  vatStatus                    String?
  // Free text for what one number can't say: a joint-venture's total
  // alongside the smaller share used as the Budget, subcontract context,
  // or why no figure was found (CONTEXT.md's Budget Note entry). "" (not
  // null) when there's nothing to add — same non-nullable-string
  // convention as descriptionTh/descriptionEn above.
  budgetNote                   String    @default("")
  budgetVerified               Boolean   @default(false)
  budgetVerifiedAt             DateTime?
  budgetVerifiedById           String?
  budgetVerifiedBy             User?     @relation("ProjectCardBudgetVerifier", fields: [budgetVerifiedById], references: [id], onDelete: SetNull)
  // The year the project's Contract was signed (CONTEXT.md's Year entry) —
  // not a delivery date or certificate issue date.
  year                         Int?
  // Technology area: a ProjectCardTerm `value` of kind "category"
  // (CONTEXT.md's Category / Tag entries): exactly one Category per card
  // once classified, plus any further areas as Tags. Null / empty until a
  // batch classifies the card.
  category                     String?
  tags                         String[]  @default([])
  // How ICN delivered the project: ProjectCardTerm values of kind
  // "workType" (CONTEXT.md's Work Type entry). Empty until classified.
  workTypes                    String[]  @default([])
  // Set when a person changes Category/Tags/Work Types in the popup, so a later push
  // never overwrites their classification (CONTEXT.md's Description Source
  // entry: person edits are never overwritten).
  classificationEditedByPerson Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([client])
  @@index([category])
}

// The company lists a Project Card's Category/Tags ("category") and Work
// Types ("workType") are chosen from — kept by admins in Admin Center, read
// by ingest validation, the popup, the search filter and free-text matching
// (CONTEXT.md's Category / Tag / Work Type entries). `value` is what cards
// store, so it never changes once created; only the labels can be renamed,
// and there is no delete (a card would be left pointing at nothing).
model ProjectCardTerm {
  id        String   @id @default(cuid())
  kind      String // "category" | "workType"
  value     String
  en        String
  th        String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
}
