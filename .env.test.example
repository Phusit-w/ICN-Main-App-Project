# Copy to `.env.test` (gitignored) for `npm test`. Points at a LOCAL Postgres
# server used only for tests — each run creates its own `test_run_*` schema
# there and drops it afterwards. Start that server with:
#   npx prisma dev --name test-db -P 51228 --shadow-db-port 51229 -p 51227
# See docs/SOC-TESTING.md. Never put a dev/production connection string here.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51228/template1?sslmode=disable"
